{
  "name": "StreamSwipe",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start:native": "react-native start",
    "ios": "react-native run-ios",
    "preview": "vite preview --port 4173",
    "generate:backend": "teeny generate --local",
    "migrate:backend": "teeny migrate --local",
    "dev:backend": "teeny dev --local",
    "build:backend": "teeny build --local",
    "exec:backend": "teeny exec --local",
    "create-guest": "teeny exec --local 'users/auth/sign-up' --method=POST '--body={\"username\":\"guest\",\"email\":\"guest@local.dev\",\"password\":\"guest123\",\"passwordConfirm\":\"guest123\",\"name\":\"Guest\",\"role\":\"guest\"}'",
    "exec-sql": "npx wrangler d1 execute PRIMARY_DB --local --persist-to \"./.local-persist\" --json --command \"select * from sqlite_master\""
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@react-native-async-storage/async-storage": "^2.1.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.0",
    "react-native-vector-icons": "^10.3.0",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@react-native-community/cli": "17.0.0",
    "@react-native/babel-preset": "0.79.0",
    "@react-native/metro-config": "0.79.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-native-vector-icons": "^6.4.18",
    "@vitejs/plugin-react": "^4.2.1",
    "teenybase": "0.0.10",
    "typescript": "~5.4.5",
    "vite": "^5.4.11"
  }
}
